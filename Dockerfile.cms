FROM node:22-alpine AS builder
WORKDIR /app

COPY apps/frontend-cms/package.json apps/frontend-cms/package-lock.json ./
RUN npm ci

COPY apps/frontend-cms/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx/cms.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
